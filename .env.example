# ─── Supabase ───────────────────────────────────────────────
# Get these from: https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_STORAGE_BUCKET=media

# ─── Cloudflare R2 (media uploads) ──────────────────────────
# Get from: https://dash.cloudflare.com → R2 → Manage API Tokens
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=your_bucket_name
R2_PUBLIC_URL=https://pub-YOUR_HASH.r2.dev

# ─── YouTube Data API v3 ─────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs → YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key_here

# ─── Claude API (for rewriting news titles/excerpts) ─────────
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Resend (contact form emails) ────────────────────────────
# Get from: https://resend.com → API Keys
RESEND_API_KEY=your_resend_api_key_here

# ─── Cron security secret ────────────────────────────────────
# Random string to protect the /api/cron/fetch-news endpoint
# Generate with: openssl rand -hex 32
CRON_SECRET=your_random_secret_here

# ─── Admin panel password ────────────────────────────────────
ADMIN_PASSWORD=your_secure_admin_password_here

# ─── Site URL ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.albaalaagh.com

# ─── Facebook (og:fb:app_id + auto-post on publish) ──────────
# App ID from: https://developers.facebook.com → Your App → Settings → Basic
NEXT_PUBLIC_FB_APP_ID=your_facebook_app_id
# Page tokens from: https://developers.facebook.com → Graph API Explorer
FB_PAGE1_ID=your_page1_id
FB_PAGE1_TOKEN=your_page1_access_token
FB_PAGE2_ID=your_page2_id
FB_PAGE2_TOKEN=your_page2_access_token

# ─── X / Twitter (auto-post on article/news publish) ─────────
# Get from: https://developer.twitter.com → Your App → Keys and Tokens
X_API_KEY=your_x_api_key
X_API_SECRET=your_x_api_secret
X_ACCESS_TOKEN=your_x_access_token
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret

# ─── Telegram (auto-post on article/news publish) ────────────
# Create bot via @BotFather, then get token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# ─── LinkedIn (auto-post on article/news publish) ────────────
# Get access token via OAuth: https://www.linkedin.com/developers/tools/oauth
# Scopes needed: w_member_social profile openid
# Get person ID: curl -H "Authorization: Bearer TOKEN" https://api.linkedin.com/v2/userinfo
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here
LINKEDIN_PERSON_ID=your_linkedin_person_id_here
# Optional: post as a company page instead (requires w_organization_social scope)
# LINKEDIN_ORGANIZATION_ID=your_org_id_here
